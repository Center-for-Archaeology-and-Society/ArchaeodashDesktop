# Copy to /srv/archaeodash/.env on cas (owner root, mode 600) and fill in.
# Never commit the filled-in file or copy its values anywhere else.

# Image tag loaded with `docker load` (archaeodash-hosted:<tag>).
ARCHAEODASH_TAG=

# Random secrets, for example from: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_PEPPER=

# Sender of verification and password-reset emails.
AUTH_SMTP_FROM=ArchaeoDash <noreply@cas.rc.asu.edu>

# Optional overrides (defaults in compose.yml):
# AUTH_QUOTA_BYTES=1073741824
# AUTH_MAX_REQUEST_BYTES=67108864
# AUTH_ANALYSIS_SLOTS=4
# AUTH_ANALYSIS_SLOTS_PER_USER=2
# Guest sessions (no account); AUTH_GUESTS=0 turns them off.
# AUTH_GUESTS=1
# AUTH_GUEST_QUOTA_BYTES=209715200
# AUTH_GUEST_TOTAL_BYTES=5368709120
# AUTH_GUEST_MAX_SESSIONS=100
